{
  "extends": "./tsconfig.json",
  // `server/locale.ts` testten doğrudan içe aktarılıyor (dil kapısı saf bir
  // fonksiyon); proje dosya listesinde adı geçmeli.
  "include": ["tests/**/*", "vitest.config.ts", "server/locale.ts"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
