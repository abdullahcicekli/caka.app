/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "caka",
	"compatibility_date": "2026-08-15",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	// Sırlar burada DEĞİL: `wrangler secret put <ad>` ile tanımlanır
	// (Değişmez #6). Bugünkü liste: BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID,
	// GOOGLE_CLIENT_SECRET, APPLE_PRIVATE_KEY, IMAGE_PROXY_SECRET,
	// MAPBOX_PUBLIC_TOKEN.
	// IMAGE_PROXY_SECRET tanımsızsa /api/gorsel tamamen kapalıdır.
	// MAPBOX_PUBLIC_TOKEN bir SIR DEĞİLDİR (ziyaretçinin HTML'ine basılır);
	// yine de `secret` olarak tutuluyor ki depoya girip taranmasın. Korumasını
	// Mapbox panelindeki URL kısıtlaması sağlar — bkz. `.dev.vars.example`.
	// Tanımsızsa konum kartı haritasız hâline düşer.
	"vars": {
		"BETTER_AUTH_URL": "https://caka.app",
		"APPLE_CLIENT_ID": "app.caka.web",
		"APPLE_TEAM_ID": "82ALKT75W8",
		"APPLE_KEY_ID": "7JP7G5WHM4"
	},
	"routes": [
		{
			"pattern": "caka.app",
			"custom_domain": true
		}
	],
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "caka-db",
			"database_id": "d4324d63-a411-4743-a3d5-1f7fa1ea9b98",
			"migrations_dir": "../../packages/db/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "caka-assets"
		}
	]
	/**
	 * Smart Placement: https://developers.cloudflare.com/workers/configuration/smart-placement/
	 * // "placement": { "mode": "smart" }
	 */
}
